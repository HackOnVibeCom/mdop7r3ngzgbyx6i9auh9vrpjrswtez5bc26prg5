{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/p/:code",
      "destination": "/api/og?code=:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Twitterbot|TelegramBot|LinkedInBot|Slackbot).*"
        }
      ]
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
